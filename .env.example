# GoreeCloud Code API
HOST=0.0.0.0
PORT=8787
CORS_ORIGIN=http://localhost:5173

# Development governed-write controls. All three are required before branch writes are allowed.
# Point to a protected file containing one application bearer token. Never commit the token file.
GOREECLOUD_CODE_WRITE_TOKEN_FILE=
# Data-minimized local JSONL audit trail for governed write attempts/outcomes.
# Use a protected application-owned path outside source control.
GOREECLOUD_CODE_AUDIT_LOG_FILE=
# Data-minimized local JSONL idempotency/reconciliation journal. Raw client keys are SHA-256 hashed before persistence.
# Use a protected application-owned path outside source control.
GOREECLOUD_CODE_IDEMPOTENCY_FILE=

# Glaze UI web client
VITE_GOREECLOUD_CODE_API_URL=http://localhost:8787

# Initial replaceable forge provider
FORGEJO_BASE_URL=https://git.example.com
# Use a narrowly scoped token for private repositories and any explicitly authorized writes. Never commit a real token.
FORGEJO_TOKEN=
# Optional for anonymous discovery of a public Forgejo user when no token is supplied.
FORGEJO_USERNAME=
FORGEJO_TIMEOUT_MS=10000
