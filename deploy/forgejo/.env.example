# M1 local/test Forgejo deployment only.
# Copy to deploy/forgejo/.env and replace every secret before use.

POSTGRES_DB=forgejo
POSTGRES_USER=forgejo
POSTGRES_PASSWORD=replace-with-a-strong-local-secret

# For reproducible environments, replace `latest` with a tested Forgejo release tag.
FORGEJO_IMAGE=codeberg.org/forgejo/forgejo:latest
FORGEJO_DOMAIN=localhost
FORGEJO_ROOT_URL=http://localhost:3000/
FORGEJO_HTTP_PORT=3000
FORGEJO_SSH_PORT=2222
FORGEJO_UID=1000
FORGEJO_GID=1000
FORGEJO_DISABLE_REGISTRATION=false
